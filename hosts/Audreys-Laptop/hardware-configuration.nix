# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "xhci_pci" "thunderbolt" "nvme" "usb_storage" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" =
    { device = "laptop-rpool/roots/nixos/empty";
      fsType = "zfs";
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/EF5B-7F52";
      fsType = "vfat";
      options = [ "fmask=0077" "dmask=0077" ];
    };

  fileSystems."/etc/nixos" =
    { device = "laptop-rpool/roots/nixos/config";
      fsType = "zfs";
    };

  fileSystems."/home" =
    { device = "laptop-rpool/local/home";
      fsType = "zfs";
    };

  fileSystems."/nix" =
    { device = "laptop-rpool/roots/nixos/nix";
      fsType = "zfs";
    };

  fileSystems."/var/lib" =
    { device = "laptop-rpool/roots/nixos/var/lib";
      fsType = "zfs";
    };

  fileSystems."/var/log" =
    { device = "laptop-rpool/roots/nixos/var/log";
      fsType = "zfs";
    };

  swapDevices =
    [ { device = "/dev/disk/by-uuid/c61cf89d-07fa-44ff-9cc3-0d30c08920fe"; }
    ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}