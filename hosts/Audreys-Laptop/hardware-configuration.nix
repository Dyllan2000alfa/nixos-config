{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "xhci_pci" "thunderbolt" "nvme" "usb_storage" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" =
    { device = "laptop-rpool/roots/nixos/empty";
      fsType = "zfs";
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/CA12-A95E";
      fsType = "vfat";
      options = [ "fmask=0022" "dmask=0022" ];
    };

  fileSystems."/etc/nixos" =
    { device = "laptop-rpool/roots/nixos/config";
      fsType = "zfs";
    };

  fileSystems."/home" =
    { device = "laptop-rpool/local/home";
      fsType = "zfs";
    };

  fileSystems."/nix" =
    { device = "laptop-rpool/roots/nixos/nix";
      fsType = "zfs";
    };

  fileSystems."/var/lib" =
    { device = "laptop-rpool/roots/nixos/var/lib";
      fsType = "zfs";
    };

  fileSystems."/var/log" =
    { device = "laptop-rpool/roots/nixos/var/log";
      fsType = "zfs";
    };

  swapDevices =
    [ { device = "/dev/disk/by-uuid/4890577f-c162-4fc1-9b74-1480f1a8039b"; }
    ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}